{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:3001" ]
  },
  "ReverseProxy": {
    "Routes": {
      "gearflow-api": {
        "ClusterId": "gearflow-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "gearflow-health": {
        "ClusterId": "gearflow-api",
        "Match": {
          "Path": "/health/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gearflow-api": {
        "Destinations": {
          "primary": {
            "Address": "http://gearflow-api:8080/"
          }
        }
      }
    }
  }
}
