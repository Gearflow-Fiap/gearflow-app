<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>gearflow-api</UserSecretsId>
  </PropertyGroup>

  <!--
    Host único do monólito modular: referencia Application (endpoints usam ISender + commands) e
    Infrastructure (composition root registra DbContext/repos/MediatR) de cada BC. À medida que os
    BCs forem migrados, adicione aqui a ProjectReference do respectivo Application + Infrastructure.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Shared.Infrastructure\Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Catalog\Catalog.Application\Catalog.Application.csproj" />
    <ProjectReference Include="..\..\Catalog\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Customers\Customers.Application\Customers.Application.csproj" />
    <ProjectReference Include="..\..\Customers\Customers.Infrastructure\Customers.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Inventory\Inventory.Application\Inventory.Application.csproj" />
    <ProjectReference Include="..\..\Inventory\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Workshop\Workshop.Application\Workshop.Application.csproj" />
    <ProjectReference Include="..\..\Workshop\Workshop.Infrastructure\Workshop.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Identity\Identity.Application\Identity.Application.csproj" />
    <ProjectReference Include="..\..\Identity\Identity.Infrastructure\Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Notifications\Notifications.Application\Notifications.Application.csproj" />
    <ProjectReference Include="..\..\Notifications\Notifications.Infrastructure\Notifications.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

</Project>
